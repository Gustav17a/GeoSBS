{
  "_comentario": "Regras de classificação das tags do OpenStreetMap. A ordem importa: o primeiro grupo que casar define a categoria. 'conditions' exige tags extras para uma regra chave=valor ('*' = qualquer valor); se não forem atendidas, testa-se o grupo seguinte. 'color' é uma das cores aceitas por folium.Icon; 'hex' é a cor da categoria no mapa principal (paleta categórica validada para daltonismo; a identidade é reforçada pelo ícone); 'icon' é um ícone Font Awesome 6 (mapa clássico); 'lucide' é o ícone SVG do mapa principal (src/visualization/icons).",
  "categories": [
    {
      "id": "farmacias",
      "label": "Farmácias",
      "color": "green", "hex": "#1baf7a", "icon": "prescription-bottle-medical", "lucide": "pill",
      "rules": {"amenity": ["pharmacy"], "healthcare": ["pharmacy"]}
    },
    {
      "id": "saude",
      "label": "Saúde",
      "color": "red", "hex": "#e34948", "icon": "hospital", "lucide": "hospital",
      "rules": {
        "amenity": ["hospital", "clinic", "doctors", "dentist"],
        "healthcare": ["hospital", "clinic", "centre", "doctor", "dentist", "laboratory", "rehabilitation", "physiotherapist", "psychotherapist"]
      }
    },
    {
      "id": "educacao",
      "label": "Educação",
      "color": "blue", "hex": "#2a78d6", "icon": "graduation-cap", "lucide": "graduation-cap",
      "rules": {"amenity": ["school", "kindergarten", "college", "university"]}
    },
    {
      "id": "seguranca",
      "label": "Segurança pública",
      "color": "darkblue", "hex": "#6250d6", "icon": "shield-halved", "lucide": "shield",
      "rules": {"amenity": ["police", "fire_station"]}
    },
    {
      "id": "transporte",
      "label": "Transporte",
      "color": "orange", "hex": "#eda100", "icon": "bus", "lucide": "bus",
      "rules": {"amenity": ["bus_station", "taxi"], "highway": ["bus_stop"], "public_transport": ["station"]}
    },
    {
      "id": "servicos_publicos",
      "label": "Serviços públicos",
      "color": "purple", "hex": "#e87ba4", "icon": "landmark", "lucide": "landmark",
      "rules": {
        "amenity": ["townhall", "courthouse", "post_office", "library", "community_centre", "social_facility"],
        "office": ["government"]
      },
      "conditions": {
        "amenity=community_centre": {"operator:type": ["public", "government"]}
      }
    },
    {
      "id": "lazer",
      "label": "Lazer e espaços públicos",
      "color": "darkgreen", "hex": "#008300", "icon": "tree", "lucide": "trees",
      "rules": {"leisure": ["park", "playground", "sports_centre", "stadium", "garden"]},
      "conditions": {
        "leisure=garden": {"name": ["*"]}
      }
    },
    {
      "id": "outros",
      "label": "Outros pontos de interesse",
      "color": "cadetblue", "hex": "#6b7280", "icon": "star", "lucide": "star",
      "rules": {
        "tourism": ["museum", "attraction", "viewpoint", "gallery"],
        "amenity": ["theatre", "arts_centre", "cinema", "marketplace", "community_centre"]
      }
    }
  ]
}
